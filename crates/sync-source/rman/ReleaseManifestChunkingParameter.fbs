namespace LeagueToolkit.IO.ReleaseManifestFile;

// Field 3 was previously named MaxChunkSize and field 4 MaxUncompressedSize; both were off
// by one slot. LeagueClient.exe 13.6 sub_5E2EB0 validates the runtime struct as
//   version in 1..4, min >= 32, min <= target, 32 <= target <= 0x800000, target <= max <= 0x800000
// which pins slot 2 = min, slot 3 = target, slot 4 = max. Data agrees: the current game
// manifest carries (250000, 1000000, 8388608), (62500, 250000, 8388608),
// (16384, 65536, 8388608) - min is always target/4, max is the same for every set.
table ReleaseManifestChunkingParameter
{
    ID: ushort;

    // Chunking version, 1..4. Also selects the chunk-id hash (13.6 sub_5FAEB0):
    //   1 = SHA512, 2 = SHA256, 3 = RITO_HKDF, 4 = BLAKE3, each truncated to 8 bytes LE.
    // The CDC gear table and masks change with it too (see ../notes.md).
    Version: ubyte;

    // No boundary is emitted before MinChunkSize bytes; the mask relaxes after
    // TargetChunkSize; MaxChunkSize is a hard cut.
    MinChunkSize: uint;
    TargetChunkSize: uint;
    MaxChunkSize: uint;
}
